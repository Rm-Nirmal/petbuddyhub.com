---
layout: layouts/base.njk
pageTitle: Contact Us
metaDescription: Get in touch with the PetBuddyHub team. We'd love to hear from you!
permalink: /contact/
---
{% from "partials/icons.njk" import icon %}

{# ===== HERO ===== #}
<section class="contact-hero">
  <div class="container">
    <div class="contact-hero__badge">{{ icon("mail", 16) }} Get In Touch</div>
    <h1 class="contact-hero__title">We'd Love to <em>Hear</em> From You</h1>
    <p class="contact-hero__subtitle">Have a question, suggestion, or partnership idea? Drop us a message and we'll get back to you within 24 hours.</p>
  </div>
  <div class="contact-hero__shape"></div>
</section>

{# ===== CONTACT INFO CARDS ===== #}
<section class="contact-info-bar">
  <div class="container">
    <div class="contact-info__grid">
      <div class="contact-info__card fade-in">
        <div class="contact-info__icon">{{ icon("mail", 22) }}</div>
        <h4>Email Us</h4>
        <p>hello@petbuddyhub.com</p>
      </div>
      <div class="contact-info__card fade-in">
        <div class="contact-info__icon">{{ icon("map-pin", 22) }}</div>
        <h4>Location</h4>
        <p>Working remotely, worldwide</p>
      </div>
      <div class="contact-info__card fade-in">
        <div class="contact-info__icon">{{ icon("clock", 22) }}</div>
        <h4>Response Time</h4>
        <p>Within 24 hours</p>
      </div>
    </div>
  </div>
</section>

{# ===== CONTACT FORM ===== #}
<section class="section">
  <div class="container">
    <div class="contact-layout">
      <div class="contact-form-wrapper fade-in">
        <div class="contact-form__header">
          <h2>Send Us a Message</h2>
          <p>Fill out the form below and we'll get back to you as soon as possible.</p>
        </div>
        <form id="contact-form" class="contact-form">
          <input type="hidden" name="subject" value="New Message from PetBuddyHub Contact Form">
          <div class="contact-form__row">
            <div class="form-group">
              <label for="name">Your Name</label>
              <input type="text" id="name" name="name" placeholder="John Doe" required>
            </div>
            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" placeholder="john@example.com" required>
            </div>
          </div>
          <div class="form-group">
            <label for="interest">Subject</label>
            <select id="interest" name="interest">
              <option value="General Inquiry">General Inquiry</option>
              <option value="Collaboration / Partnership">Collaboration / Partnership</option>
              <option value="Product Review Request">Product Review Request</option>
              <option value="Feedback">Feedback</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell us what's on your mind..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">
            Send Message {{ icon("arrow-right", 16) }}
          </button>
        </form>
      </div>

      <div class="contact-sidebar fade-in">
        <div class="contact-sidebar__card">
          <div class="contact-sidebar__card-icon">{{ icon("paw", 24) }}</div>
          <h4>Follow Us</h4>
          <p>Stay connected for daily pet care tips and behind-the-scenes content.</p>
          <div class="contact-sidebar__socials">
            <a href="#" class="contact-social-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              Instagram
            </a>
            <a href="#" class="contact-social-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              Facebook
            </a>
            <a href="#" class="contact-social-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
              Twitter
            </a>
          </div>
        </div>

        <div class="contact-sidebar__card">
          <div class="contact-sidebar__card-icon">{{ icon("guides", 24) }}</div>
          <h4>FAQs</h4>
          <p>Most questions are answered within our guides. Check our Start Here page for curated beginner resources.</p>
          <a href="{{ '/start-here/' | url }}" class="btn btn-outline" style="width: 100%; justify-content: center; margin-top: 8px;">Visit Start Here</a>
        </div>
      </div>
    </div>
  </div>
</section>
