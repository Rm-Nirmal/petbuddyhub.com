{% from "partials/icons.njk" import icon %}
<aside>
  <!-- Categories -->
  <div class="sidebar__section">
    <h4 class="sidebar__title">Categories</h4>
    <ul class="sidebar__categories">
      {% for cat in categories %}
        <li><a href="{{ ('/categories/#' + cat.slug) | url }}">{{ cat.name }}</a></li>
      {% endfor %}
    </ul>
  </div>

  <!-- Newsletter -->
  <div class="sidebar__section">
    <h4 class="sidebar__title">Newsletter</h4>
    <p style="font-size: 0.9rem; color: var(--text-light); margin-bottom: 16px;">Get weekly pet care tips & exclusive guides.</p>
    <input type="email" placeholder="Your email" style="width:100%; padding: 12px 16px; border: 2px solid var(--border); border-radius: var(--radius-sm); font-family: var(--font-body); margin-bottom: 10px; outline: none;">
    <button class="btn btn-primary" style="width:100%; justify-content: center;">Subscribe</button>
  </div>

  <!-- Ad Slot -->
  <div class="ad-slot">Advertisement</div>

  <!-- Popular Posts -->
  <div class="sidebar__section">
    <h4 class="sidebar__title">Popular Posts</h4>
    {% set sidebarPosts = sanityPosts if sanityPosts.length else collections.posts %}
    {% for post in sidebarPosts %}
      {% if loop.index <= 3 %}
        {% set postTitle = post.data.title if post.data else post.title %}
        {% set postImage = (("/assets/" + post.data.image) | url) if post.data else post.featuredImage %}
        {% set postUrl = post.url if post.data else ("/blog/" + post.slug + "/") %}
        {% set postDate = post.data.date if post.data else post.publishedAt %}
        <div style="display:flex; gap:12px; margin-bottom:16px; align-items:center;">
          {% if postImage %}
            <img src="{{ postImage }}" alt="{{ postTitle }}" style="width:64px; height:64px; object-fit:cover; border-radius: var(--radius-sm); flex-shrink:0;" loading="lazy">
          {% endif %}
          <div>
            <a href="{{ postUrl | url }}" style="font-size:0.85rem; font-weight:600; color:var(--text); line-height:1.3; display:block;">{{ postTitle | truncate(50) }}</a>
            <span style="font-size:0.75rem; color:var(--text-muted);">{{ postDate | dateShort }}</span>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</aside>
