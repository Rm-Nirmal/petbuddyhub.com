<nav class="navbar" id="navbar">
  <div class="navbar__inner">
    <a href="/" class="navbar__logo" aria-label="PetBuddyHub Home">
      <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="14" cy="10" rx="5" ry="6.5"/>
        <ellipse cx="34" cy="10" rx="5" ry="6.5"/>
        <ellipse cx="7" cy="24" rx="4.5" ry="5.5"/>
        <ellipse cx="41" cy="24" rx="4.5" ry="5.5"/>
        <ellipse cx="24" cy="30" rx="12" ry="11"/>
      </svg>
      PetBuddyHub
    </a>

    <ul class="navbar__links" id="navLinks">
      {% for item in navigation %}
        {% if item.children %}
          <li class="nav-dropdown">
            <a href="{{ item.url }}" class="nav-dropdown__toggle{% if page.url == item.url %} active{% endif %}">
              {{ item.label }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </a>
            <div class="nav-dropdown__menu">
              {% for child in item.children %}
                <a href="{{ child.url }}">{{ child.label }}</a>
              {% endfor %}
            </div>
          </li>
        {% else %}
          <li>
            <a href="{{ item.url }}"{% if page.url == item.url %} class="active"{% endif %}>{{ item.label }}</a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>

    <button class="navbar__burger" id="navBurger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
