{
  "name": "petbuddyhub",
  "version": "1.0.0",
  "description": "PetBuddyHub - Your Trusted Pet Care Companion. A pet blogging site built with Eleventy & Sanity CMS.",
  "scripts": {
    "dev": "concurrently --names site,watch --prefix-colors blue,green \"npx @11ty/eleventy --serve\" \"node scripts/sanity-watch.js\"",
    "build": "npx @11ty/eleventy",
    "debug": "DEBUG=Eleventy* npx @11ty/eleventy"
  },
  "keywords": [
    "pets",
    "blog",
    "eleventy",
    "nunjucks",
    "sanity"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@portabletext/to-html": "^2.0.13",
    "@sanity/client": "^6.24.1",
    "@sanity/image-url": "^1.1.0",
    "dotenv": "^16.4.7"
  }
}
