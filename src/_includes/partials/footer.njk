{% from "partials/icons.njk" import icon %}

<footer class="footer">
  {# ===== MAIN FOOTER ===== #}
  <div class="footer__main">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__brand">
          <a href="{{ '/' | url }}" class="footer__logo">
            <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="14" cy="10" rx="5" ry="6.5"/>
              <ellipse cx="34" cy="10" rx="5" ry="6.5"/>
              <ellipse cx="7" cy="24" rx="4.5" ry="5.5"/>
              <ellipse cx="41" cy="24" rx="4.5" ry="5.5"/>
              <ellipse cx="24" cy="30" rx="12" ry="11"/>
            </svg>
            PetBuddyHub
          </a>
          <p>Your trusted companion for expert pet care advice, honest product reviews, and practical guides to help your furry friends thrive.</p>
          <div class="footer__socials">
            <a href="#" class="footer__social" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href="#" class="footer__social" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="#" class="footer__social" aria-label="Twitter">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
            </a>
            <a href="#" class="footer__social" aria-label="Pinterest">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 12a4 4 0 1 1 8 0c0 4-3 6-3 6"/><line x1="12" y1="12" x2="12" y2="21"/></svg>
            </a>
          </div>
        </div>

        <div class="footer__col">
          <h4 class="footer__heading">Quick Links</h4>
          <ul class="footer__links">
            <li><a href="{{ '/' | url }}">Home</a></li>
            <li><a href="{{ '/blog/' | url }}">Blog</a></li>
            <li><a href="{{ '/start-here/' | url }}">Start Here</a></li>
            <li><a href="{{ '/about/' | url }}">About</a></li>
            <li><a href="{{ '/contact/' | url }}">Contact</a></li>
          </ul>
        </div>

        <div class="footer__col">
          <h4 class="footer__heading">Categories</h4>
          <ul class="footer__links">
            {% for cat in categories %}
              <li><a href="{{ ('/categories/#' + cat.slug) | url }}">{{ cat.name }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer__col">
          <h4 class="footer__heading">Why PetBuddyHub?</h4>
          <p class="footer__col-desc">Simple, practical, and research-based pet care information for everyday pet owners.</p>
          <ul class="footer__links footer__trust-list">
            <li>
              <a href="{{ '/about/' | url }}">
                {{ icon("check", 14) }} Expert-reviewed content
              </a>
            </li>
            <li>
              <a href="{{ '/about/' | url }}">
                {{ icon("check", 14) }} Beginner-friendly guides
              </a>
            </li>
            <li>
              <a href="{{ '/start-here/' | url }}">
                {{ icon("check", 14) }} Updated regularly
              </a>
            </li>
          </ul>
        </div>
      </div>

      {# ===== FOOTER BOTTOM ===== #}
      <div class="footer__bottom">
        <p>&copy; {{ 2026 }} {{ site.title }}. All rights reserved.</p>
        <div class="footer__bottom-links">
          <a href="{{ '/privacy-policy/' | url }}">Privacy Policy</a>
          <span class="footer__dot"></span>
          <a href="{{ '/disclaimer/' | url }}">Disclaimer</a>
          <span class="footer__dot"></span>
          <a href="{{ '/contact/' | url }}">Contact</a>
        </div>
      </div>
    </div>
  </div>
</footer>
