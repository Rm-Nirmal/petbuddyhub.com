---
layout: layouts/base.njk
pageTitle: Start Here
metaDescription: New to PetBuddyHub? This is the perfect place to begin your pet care journey. We've organized our best resources just for you.
permalink: /start-here/
---
{% from "partials/icons.njk" import icon %}

{# ===== HERO ===== #}
<section class="start-hero">
  <div class="container">
    <div class="start-hero__badge">{{ icon("compass", 16) }} Your Starting Point</div>
    <h1 class="start-hero__title">Welcome to <em>PetBuddyHub</em></h1>
    <p class="start-hero__subtitle">New to pet parenting or just found us? Here's everything you need, organized, expert-backed, and easy to follow.</p>
  </div>
  <div class="start-hero__shape"></div>
</section>

{# ===== HOW IT WORKS ===== #}
<section class="section">
  <div class="container">
    <div class="section__header">
      <h2>Choose Your Path</h2>
      <p>Whether you're a brand-new pet owner or looking for specific advice, we've got you covered.</p>
    </div>
    <div class="start-paths">
      <a href="{{ '/blog/10-essential-tips-for-bringing-home-your-new-puppy/' | url }}" class="start-path-card fade-in">
        <div class="start-path-card__number">01</div>
        <div class="start-path-card__icon">{{ icon("paw", 28) }}</div>
        <h3>New Pet Owner?</h3>
        <p>Everything you need to know about bringing home your first pet, from puppy-proofing your house to choosing the right vet.</p>
        <span class="start-path-card__link">
          Read the Guide
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </span>
      </a>
      <a href="{{ '/blog/best-dog-food-brands-2026-guide/' | url }}" class="start-path-card fade-in">
        <div class="start-path-card__number">02</div>
        <div class="start-path-card__icon">{{ icon("food", 28) }}</div>
        <h3>Nutrition & Food</h3>
        <p>Confused about what to feed your pet? Our nutrition guides break down the best foods, portion sizes, and dietary needs.</p>
        <span class="start-path-card__link">
          Explore Food Guides
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </span>
      </a>
      <a href="{{ '/categories/#training' | url }}" class="start-path-card fade-in">
        <div class="start-path-card__number">03</div>
        <div class="start-path-card__icon">{{ icon("training", 28) }}</div>
        <h3>Training Essentials</h3>
        <p>From basic commands to behavior issues. Learn positive training techniques that actually work.</p>
        <span class="start-path-card__link">
          Training Articles
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </span>
      </a>
    </div>
  </div>
</section>

{# ===== POPULAR ARTICLES ===== #}
<section class="section section--alt">
  <div class="container">
    <div class="section__header">
      <h2>Most Popular Articles</h2>
      <p>These are our most-read articles that helped thousands of pet parents.</p>
    </div>
    <div class="posts-grid">
      {% set postList = sanityPosts if sanityPosts.length else collections.posts %}
      {% for post in postList %}
        {% if loop.index <= 3 %}
          {% include "partials/post-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{# ===== PRODUCT REVIEWS CTA ===== #}
<section class="section">
  <div class="container">
    <div class="start-cta fade-in">
      <div class="start-cta__icon">{{ icon("reviews", 36) }}</div>
      <div class="start-cta__content">
        <h2>Looking for Product Recommendations?</h2>
        <p>Check out our honest, hands-on reviews of the best pet products, from food to toys to grooming tools.</p>
      </div>
      <a href="{{ '/categories/#product-reviews' | url }}" class="btn btn-primary">See Reviews {{ icon("arrow-right", 16) }}</a>
    </div>
  </div>
</section>

{# ===== FEATURED CATEGORIES ===== #}
<section class="section section--alt">
  <div class="container">
    <div class="section__header">
      <h2>Explore All Categories</h2>
      <p>Browse our organized collection of pet care content by topic.</p>
    </div>
    <div class="home-categories">
      {% for cat in categories %}
        <a href="{{ ('/categories/#' + cat.slug) | url }}" class="home-cat-card fade-in">
          <div class="home-cat-card__icon">{{ icon(cat.icon, 24) }}</div>
          <div class="home-cat-card__content">
            <div class="home-cat-card__title">{{ cat.name }}</div>
            <div class="home-cat-card__desc">{{ cat.description }}</div>
          </div>
          <div class="home-cat-card__arrow">{{ icon("arrow-right", 16) }}</div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

