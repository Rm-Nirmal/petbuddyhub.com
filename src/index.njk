---
layout: layouts/base.njk
pageTitle: Your Trusted Pet Care Companion
metaDescription: Expert pet care tips, training guides, honest product reviews, and nutrition advice to help your furry friends live their best life.
---
{% from "partials/icons.njk" import icon %}

{# ===== HERO ===== #}
<section class="home-hero">
  <div class="container">
    <div class="home-hero__inner">
      <div class="home-hero__text">
        <div class="home-hero__badge">
          {{ icon("paw", 16) }} Your Trusted Pet Care Hub
        </div>
        <h1 class="home-hero__title">Give Your Pet The <em>Best Life</em> Possible</h1>
        <p class="home-hero__subtitle">Expert-backed training tips, nutrition guides, and honest product reviews. Everything you need to be the best pet parent.</p>
        <div class="home-hero__ctas">
          <a href="{{ '/start-here/' | url }}" class="btn btn-primary">
            Explore Pet Care Guides {{ icon("arrow-right", 18) }}
          </a>
          <a href="{{ '/blog/' | url }}" class="btn btn-outline">Browse Articles</a>
        </div>
      </div>
      <div class="home-hero__image">
        <img src="{{ '/assets/zigmarsberzins-girl-5623231_1920.jpg' | url }}" alt="Happy pet owner with dog" width="580" height="400">
      </div>
    </div>
  </div>
  <div class="home-hero__shape"></div>
</section>

{# ===== TRUST BAR ===== #}
<section class="home-trust">
  <div class="container">
    <div class="home-trust__grid">
      <div class="home-trust__item fade-in">
        <div class="home-trust__icon">{{ icon("shield", 22) }}</div>
        <div>
          <div class="home-trust__label">Trusted Content</div>
          <div class="home-trust__desc">Expert-reviewed pet care information</div>
        </div>
      </div>
      <div class="home-trust__item fade-in">
        <div class="home-trust__icon">{{ icon("bookmark", 22) }}</div>
        <div>
          <div class="home-trust__label">Beginner-Friendly</div>
          <div class="home-trust__desc">Easy-to-follow guides for new owners</div>
        </div>
      </div>
      <div class="home-trust__item fade-in">
        <div class="home-trust__icon">{{ icon("search", 22) }}</div>
        <div>
          <div class="home-trust__label">Research-Backed</div>
          <div class="home-trust__desc">Based on veterinary science & data</div>
        </div>
      </div>
      <div class="home-trust__item fade-in">
        <div class="home-trust__icon">{{ icon("refresh", 22) }}</div>
        <div>
          <div class="home-trust__label">Updated Regularly</div>
          <div class="home-trust__desc">Fresh content added every week</div>
        </div>
      </div>
    </div>
  </div>
</section>

{# ===== PAW DIVIDER ===== #}
<div class="paw-divider">
  <span>{{ icon("paw", 18) }}</span>
</div>

{# ===== CATEGORIES ===== #}
<section class="section">
  <div class="container">
    <div class="section__header">
      <h2>Explore by Category</h2>
      <p>Find exactly what you need, from training basics to expert product reviews.</p>
    </div>
    <div class="home-categories">
      {% for cat in categories %}
        <a href="{{ ('/categories/#' + cat.slug) | url }}" class="home-cat-card fade-in">
          <div class="home-cat-card__icon">{{ icon(cat.icon, 24) }}</div>
          <div class="home-cat-card__content">
            <div class="home-cat-card__title">{{ cat.name }}</div>
            <div class="home-cat-card__desc">{{ cat.description }}</div>
          </div>
          <div class="home-cat-card__arrow">{{ icon("arrow-right", 16) }}</div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{# ===== LATEST POSTS ===== #}
<section class="section section--alt">
  <div class="container">
    <div class="home-section-bar">
      <div>
        <h2 class="home-section-bar__title">Latest Articles</h2>
        <p class="home-section-bar__desc">Fresh insights and tips from our pet care experts.</p>
      </div>
      <a href="{{ '/blog/' | url }}" class="btn btn-outline">View All {{ icon("arrow-right", 16) }}</a>
    </div>
    <div class="posts-grid">
      {% set postList = sanityPosts if sanityPosts.length else collections.posts %}
      {% for post in postList %}
        {% if loop.index <= 3 %}
          {% include "partials/post-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{# ===== HOW WE HELP ===== #}
<section class="section">
  <div class="container">
    <div class="section__header">
      <h2>How We Help You</h2>
      <p>PetBuddyHub is designed to make pet parenting easier at every step of the journey.</p>
    </div>
    <div class="home-help-grid">
      <div class="home-help-card fade-in">
        <div class="home-help-card__num">01</div>
        <div class="home-help-card__icon">{{ icon("search", 26) }}</div>
        <h3>Research & Verify</h3>
        <p>Every article is backed by veterinary science and expert consultation. We fact-check so you don't have to.</p>
      </div>
      <div class="home-help-card fade-in">
        <div class="home-help-card__num">02</div>
        <div class="home-help-card__icon">{{ icon("reviews", 26) }}</div>
        <h3>Test & Review</h3>
        <p>We personally test products before recommending them. Our reviews are honest, detailed, and never sponsored.</p>
      </div>
      <div class="home-help-card fade-in">
        <div class="home-help-card__num">03</div>
        <div class="home-help-card__icon">{{ icon("training", 26) }}</div>
        <h3>Guide & Educate</h3>
        <p>From beginner basics to advanced training, our step-by-step guides make learning simple and enjoyable.</p>
      </div>
    </div>
  </div>
</section>

{# ===== FEATURED BANNER ===== #}
<section class="section section--alt">
  <div class="container">
    <div class="home-banner fade-in">
      <div class="home-banner__content">
        <div class="home-banner__badge">{{ icon("compass", 16) }} Getting Started</div>
        <h2>New Pet Parent? Start Here</h2>
        <p>We've curated the ultimate beginner's guide with everything you need to know, from choosing the right food to mastering basic training.</p>
        <a href="{{ '/start-here/' | url }}" class="btn">Read the Guide {{ icon("arrow-right", 16) }}</a>
      </div>
      <div class="home-banner__visual">
        <img src="{{ '/assets/carah-puppy-3979350_1920.jpg' | url }}" alt="Cute puppy" loading="lazy">
      </div>
    </div>
  </div>
</section>

{# ===== FEATURED CATEGORIES SHOWCASE ===== #}
<section class="section">
  <div class="container">
    <div class="section__header">
      <h2>Browse Our Top Categories</h2>
      <p>Dive into our most popular topics and find exactly what you're looking for.</p>
    </div>
    <div class="home-featured-cats">
      {% for cat in categories %}
        {% if loop.index <= 4 %}
          <a href="{{ ('/categories/#' + cat.slug) | url }}" class="home-featured-cat fade-in">
            <div class="home-featured-cat__image">
              <img src="{{ ('/assets/' + cat.image) | url }}" alt="{{ cat.name }}" loading="lazy">
            </div>
            <div class="home-featured-cat__overlay">
              <div class="home-featured-cat__icon">{{ icon(cat.icon, 22) }}</div>
              <h3>{{ cat.name }}</h3>
              <p>{{ cat.description }}</p>
              <span class="home-featured-cat__link">Explore {{ icon("arrow-right", 14) }}</span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{# ===== WHY TRUST US ===== #}
<section class="section section--alt">
  <div class="container">
    <div class="home-why-trust fade-in">
      <div class="home-why-trust__icon">{{ icon("paw", 32) }}</div>
      <h2>Why Pet Parents Trust Us</h2>
      <p class="home-why-trust__desc">At PetBuddyHub, we focus on simple, practical, and research-based pet care information for everyday pet owners. Every piece of content is carefully crafted to help you and your pet thrive together.</p>
      <div class="home-why-trust__features">
        <div class="home-why-trust__feature">
          <span class="home-why-trust__check">{{ icon("check", 16) }}</span>
          <span>Veterinary-reviewed articles</span>
        </div>
        <div class="home-why-trust__feature">
          <span class="home-why-trust__check">{{ icon("check", 16) }}</span>
          <span>No sponsored content</span>
        </div>
        <div class="home-why-trust__feature">
          <span class="home-why-trust__check">{{ icon("check", 16) }}</span>
          <span>Practical, actionable advice</span>
        </div>
        <div class="home-why-trust__feature">
          <span class="home-why-trust__check">{{ icon("check", 16) }}</span>
          <span>Written by real pet owners</span>
        </div>
      </div>
      <a href="{{ '/about/' | url }}" class="btn btn-primary" style="margin-top: 12px;">Learn More About Us {{ icon("arrow-right", 16) }}</a>
    </div>
  </div>
</section>
